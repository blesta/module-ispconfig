<?php /** @var View $this **/ ?>

<table class="table">
    <thead>
        <tr>
            <th><i class="bi bi-arrow-up"></i></th>
            <th><?php $this->_('Ispconfig.service_info.username'); ?></th>
            <th><?php $this->_('Ispconfig.service_info.password'); ?></th>
            <th><?php $this->_('Ispconfig.service_info.server'); ?></th>
            <th><?php $this->_('Ispconfig.service_info.options'); ?></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td></td>
            <td><?php echo isset($service_fields->ispconfig_username)
                ? $this->Html->safe($service_fields->ispconfig_username)
                : null; ?></td>
            <td><?php echo isset($service_fields->ispconfig_password)
                ? $this->Html->safe($service_fields->ispconfig_password)
                : null; ?></td>
            <td><?php echo isset($module_row->meta->host_name)
                ? $this->Html->safe($module_row->meta->host_name)
                : null; ?></td>
            <td>
                <?php
                $this->Form->create(
                    $this->Html->safe(
                        'https://' .
                            ($module_row->meta->host_name ?? null) .
                            ':' .
                            ($module_row->meta->port ?? null) .
                            '/login/',
                    ),
                    ['target' => '_blank'],
                );
                $this->Form->fieldHidden(
                    'username',
                    $service_fields->ispconfig_username ?? null,
                );
                $this->Form->fieldHidden(
                    'password',
                    $service_fields->ispconfig_password ?? null,
                );
                $this->Form->fieldHidden('s_mod', 'login');
                $this->Form->fieldHidden('s_pg', 'index');
                ?>
                <a id="ispconfig_login<?php echo isset($service->id)
                    ? $this->Html->safe($service->id)
                    : null; ?>" href="#"><?php $this->_('Ispconfig.service_info.option_login'); ?></a>
                <?php $this->Form->end(); ?>
            </td>
        </tr>
    </tbody>
</table>
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('ispconfig_login<?php echo isset($service->id)
            ? $this->Html->safe($service->id)
            : null; ?>').addEventListener('click', function(e) {
            e.preventDefault();

            this.closest('form').submit();
        });
    });
</script>
